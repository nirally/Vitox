+/* ======================================================================================================================
+ * Vitox M7B.2: DIAGNOSTIC PSO field bisect. Everything below works on COPIES; the real variant stays NULL and contained.
+ * ====================================================================================================================== */
+
+#include <stdlib.h>
+
+#define B "[vitox-bisect] "
+
+/* ---- stream map: offset of each subobject wrapper, SIZE_MAX if absent ---- */
+#define MAP_TYPES 64
+struct stream_map { size_t off[MAP_TYPES]; };
+
+static size_t subobject_size(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE t) {
+   switch (t) {
+#define SZ(ID, T) case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_##ID: return sizeof(WRAP(T));
+   SZ(ROOT_SIGNATURE, ID3D12RootSignature *) SZ(VS, D3D12_SHADER_BYTECODE) SZ(PS, D3D12_SHADER_BYTECODE) SZ(DS, D3D12_SHADER_BYTECODE)
+   SZ(HS, D3D12_SHADER_BYTECODE) SZ(GS, D3D12_SHADER_BYTECODE) SZ(CS, D3D12_SHADER_BYTECODE) SZ(STREAM_OUTPUT, D3D12_STREAM_OUTPUT_DESC)
+   SZ(BLEND, D3D12_BLEND_DESC) SZ(SAMPLE_MASK, UINT) SZ(RASTERIZER, D3D12_RASTERIZER_DESC) SZ(RASTERIZER1, D3D12_RASTERIZER_DESC1)
+   SZ(RASTERIZER2, D3D12_RASTERIZER_DESC2) SZ(DEPTH_STENCIL, D3D12_DEPTH_STENCIL_DESC) SZ(DEPTH_STENCIL1, D3D12_DEPTH_STENCIL_DESC1)
+   SZ(DEPTH_STENCIL2, D3D12_DEPTH_STENCIL_DESC2) SZ(INPUT_LAYOUT, D3D12_INPUT_LAYOUT_DESC) SZ(IB_STRIP_CUT_VALUE, D3D12_INDEX_BUFFER_STRIP_CUT_VALUE)
+   SZ(PRIMITIVE_TOPOLOGY, D3D12_PRIMITIVE_TOPOLOGY_TYPE) SZ(RENDER_TARGET_FORMATS, vitox_rt_format_array) SZ(DEPTH_STENCIL_FORMAT, DXGI_FORMAT)
+   SZ(SAMPLE_DESC, DXGI_SAMPLE_DESC) SZ(NODE_MASK, UINT) SZ(CACHED_PSO, D3D12_CACHED_PIPELINE_STATE) SZ(FLAGS, D3D12_PIPELINE_STATE_FLAGS)
+   SZ(VIEW_INSTANCING, D3D12_VIEW_INSTANCING_DESC)
+#undef SZ
+   default: return 0;
+   }
+}
+
+static void map_stream(const void *buf, size_t total, struct stream_map *m) {
+   for (unsigned i = 0; i < MAP_TYPES; i++)
+      m->off[i] = SIZE_MAX;
+   const uint8_t *base = buf;
+   size_t off = 0;
+   while (off < total) {
+      off = ALIGN_POT(off, alignof(void *));
+      if (off + sizeof(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE) > total)
+         break;
+      const D3D12_PIPELINE_STATE_SUBOBJECT_TYPE t = *(const D3D12_PIPELINE_STATE_SUBOBJECT_TYPE *)(base + off);
+      const size_t size = subobject_size(t);
+      if (!size || (unsigned)t >= MAP_TYPES)
+         break;
+      m->off[t] = off;
+      off += size;
+   }
+}
+
+/* pointer to the desc of subobject ID in buf, or NULL */
+#define DESC(buf, m, ID, T) \
+   ((m).off[D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_##ID] == SIZE_MAX ? NULL \
+       : &((WRAP(T) *)((uint8_t *)(buf) + (m).off[D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_##ID]))->desc)
+
+/* ---- DXIL container inventory (signatures ISG1/OSG1, PSV0 resources + interpolation, SFI0, program version, digest) ---- */
+struct sig_elem {
+   char name[32];
+   uint32_t sem_index, sv, comp, reg;
+   uint8_t mask, rw;
+};
+struct psv_elem {
+   char name[32];
+   uint8_t rows, start_row, cols, start_col, kind, comp, interp;
+};
+struct psv_res { uint32_t type, space, lo, hi; };
+struct dxil_info {
+   bool ok;
+   uint8_t digest[16];
+   uint32_t prog_version;
+   bool has_sfi0;
+   uint64_t sfi0;
+   unsigned nin, nout, npin, npout, nres;
+   struct sig_elem in[32], out[32];
+   struct psv_elem pin[32], pout[32];
+   struct psv_res res[32];
+   uint32_t psv_size, res_stride;
+};
+
+static uint32_t rd32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+#define FOURCC(a, b, c, d) ((uint32_t)(a) | (uint32_t)(b) << 8 | (uint32_t)(c) << 16 | (uint32_t)(d) << 24)
+
+static const uint8_t *find_part(const uint8_t *blob, size_t len, uint32_t fourcc, uint32_t *size) {
+   if (len < 32 || rd32(blob) != FOURCC('D', 'X', 'B', 'C'))
+      return NULL;
+   const uint32_t count = rd32(blob + 28);
+   for (uint32_t i = 0; i < count && 32 + 4 * (i + 1) <= len; i++) {
+      const uint32_t off = rd32(blob + 32 + 4 * i);
+      if (off + 8 > len)
+         continue;
+      const uint32_t psize = rd32(blob + off + 4);
+      if (rd32(blob + off) == fourcc && off + 8 + psize <= len) {
+         *size = psize;
+         return blob + off + 8;
+      }
+   }
+   return NULL;
+}
+
+static void copy_name(char dst[32], const uint8_t *part, uint32_t part_size, uint32_t name_off) {
+   dst[0] = 0;
+   if (name_off >= part_size)
+      return;
+   size_t n = 0;
+   while (n < 31 && name_off + n < part_size && part[name_off + n])
+      dst[n] = (char)part[name_off + n], ++n;
+   dst[n] = 0;
+}
+
+static unsigned parse_sig(const uint8_t *p, uint32_t size, struct sig_elem *e) {
+   if (!p || size < 8)
+      return 0;
+   const uint32_t count = rd32(p), off = rd32(p + 4);
+   unsigned n = 0;
+   for (uint32_t i = 0; i < count && n < 32 && off + 32 * (i + 1) <= size; i++, n++) {
+      const uint8_t *q = p + off + 32 * i;
+      copy_name(e[n].name, p, size, rd32(q + 4));
+      e[n].sem_index = rd32(q + 8), e[n].sv = rd32(q + 12), e[n].comp = rd32(q + 16), e[n].reg = rd32(q + 20);
+      e[n].mask = q[24], e[n].rw = q[25];
+   }
+   return n;
+}
+
+static void parse_psv(const uint8_t *p, uint32_t size, struct dxil_info *d) {
+   if (!p || size < 4)
+      return;
+   d->psv_size = rd32(p);
+   size_t q = 4 + d->psv_size;
+   if (q + 4 > size)
+      return;
+   unsigned n_in = 0, n_out = 0;
+   if (d->psv_size >= 36) /* dxil_psv_runtime_info_1: sig_input_elements @28, sig_output_elements @29 */
+      n_in = p[4 + 28], n_out = p[4 + 29];
+   const uint32_t rc = rd32(p + q);
+   q += 4;
+   if (rc) {
+      if (q + 4 > size)
+         return;
+      d->res_stride = rd32(p + q);
+      q += 4;
+      for (uint32_t i = 0; i < rc && q + d->res_stride <= size && d->res_stride >= 16; i++, q += d->res_stride)
+         if (d->nres < 32)
+            d->res[d->nres++] = (struct psv_res){ rd32(p + q), rd32(p + q + 4), rd32(p + q + 8), rd32(p + q + 12) };
+   }
+   if (q + 4 > size)
+      return;
+   const uint32_t st_size = rd32(p + q);
+   const size_t st = q + 4;
+   q = st + st_size;
+   if (q + 4 > size)
+      return;
+   q += 4 + 4 * (size_t)rd32(p + q); /* semantic index table */
+   if (!(n_in || n_out) || q + 4 > size)
+      return;
+   const uint32_t es = rd32(p + q);
+   q += 4;
+   for (unsigned i = 0; i < n_in + n_out && es >= 12 && q + es <= size; i++, q += es) {
+      struct psv_elem *e = i < n_in ? (d->npin < 32 ? &d->pin[d->npin++] : NULL) : (d->npout < 32 ? &d->pout[d->npout++] : NULL);
+      if (!e)
+         continue;
+      copy_name(e->name, p + st, st_size, rd32(p + q));
+      e->rows = p[q + 8], e->start_row = p[q + 9], e->cols = p[q + 10] & 0xF, e->start_col = (p[q + 10] >> 4) & 3;
+      e->kind = p[q + 11], e->comp = p[q + 12], e->interp = p[q + 13];
+   }
+}
+
+static bool dxil_sfi0(const D3D12_SHADER_BYTECODE *bc, uint64_t *flags) {
+   *flags = 0;
+   uint32_t sz;
+   const uint8_t *p = bc && bc->pShaderBytecode ? find_part(bc->pShaderBytecode, bc->BytecodeLength, FOURCC('S', 'F', 'I', '0'), &sz) : NULL;
+   if (!p || sz < 8)
+      return false;
+   memcpy(flags, p, 8);
+   return true;
+}
+
+static void inspect_dxil(const D3D12_SHADER_BYTECODE *bc, struct dxil_info *d) {
+   memset(d, 0, sizeof(*d));
+   if (!bc || !bc->pShaderBytecode || bc->BytecodeLength < 32)
+      return;
+   const uint8_t *blob = bc->pShaderBytecode;
+   const size_t len = bc->BytecodeLength;
+   if (rd32(blob) != FOURCC('D', 'X', 'B', 'C'))
+      return;
+   d->ok = true;
+   memcpy(d->digest, blob + 4, 16);
+   uint32_t sz;
+   const uint8_t *p;
+   if ((p = find_part(blob, len, FOURCC('D', 'X', 'I', 'L'), &sz)) && sz >= 4)
+      d->prog_version = rd32(p);
+   if ((p = find_part(blob, len, FOURCC('S', 'F', 'I', '0'), &sz)) && sz >= 8)
+      d->has_sfi0 = true, memcpy(&d->sfi0, p, 8);
+   p = find_part(blob, len, FOURCC('I', 'S', 'G', '1'), &sz);
+   d->nin = p ? parse_sig(p, sz, d->in) : 0;
+   p = find_part(blob, len, FOURCC('O', 'S', 'G', '1'), &sz);
+   d->nout = p ? parse_sig(p, sz, d->out) : 0;
+   p = find_part(blob, len, FOURCC('P', 'S', 'V', '0'), &sz);
+   parse_psv(p, sz, d);
+}
+
+static const char *sv_name(uint32_t sv) {
+   switch (sv) {
+   case 0: return "-"; case 1: return "SV_Position"; case 2: return "SV_ClipDistance"; case 3: return "SV_CullDistance";
+   case 4: return "SV_RTArrayIndex"; case 5: return "SV_ViewportArrayIndex"; case 6: return "SV_VertexID"; case 7: return "SV_PrimitiveID";
+   case 8: return "SV_InstanceID"; case 9: return "SV_IsFrontFace"; case 10: return "SV_SampleIndex"; case 64: return "SV_Target";
+   case 65: return "SV_Depth"; case 66: return "SV_Coverage"; default: return "SV_other";
+   }
+}
+static const char *comp_name(uint32_t c) {
+   switch (c) { case 0: return "unknown"; case 1: return "uint32"; case 2: return "int32"; case 3: return "float32"; case 4: return "uint16";
+   case 5: return "int16"; case 6: return "float16"; default: return "other"; }
+}
+static const char *interp_name(uint8_t i) {
+   switch (i) { case 0: return "undefined"; case 1: return "constant"; case 2: return "linear"; case 3: return "linear_centroid";
+   case 4: return "linear_noperspective"; case 5: return "linear_noperspective_centroid"; case 6: return "linear_sample";
+   case 7: return "linear_noperspective_sample"; default: return "?"; }
+}
+
+static void log_sfi0(uint64_t f) {
+   static const char *names[] = { "Doubles", "ComputeShadersPlusRawAndStructuredBuffers", "UAVsAtEveryStage", "64UAVs", "MinimumPrecision",
+      "11_1_DoubleExtensions", "11_1_ShaderExtensions", "LEVEL9ComparisonFiltering", "TiledResources", "StencilRef", "InnerCoverage",
+      "TypedUAVLoadAdditionalFormats", "ROVs", "ViewportAndRTArrayIndexFromAnyShader", "WaveOps", "Int64Ops", "ViewID", "Barycentrics",
+      "NativeLowPrecision", "ShadingRate", "Raytracing_Tier_1_1", "SamplerFeedback", "AtomicInt64OnTypedResource", "AtomicInt64OnGroupShared",
+      "DerivativesInMeshAndAmpShaders", "ResourceDescriptorHeapIndexing", "SamplerDescriptorHeapIndexing", "bit27", "AtomicInt64OnHeapResource",
+      "AdvancedTextureOps", "WriteableMSAATextures", "SampleCmpWithGradientOrBias", "ExtendedCommandInfo" };
+   fprintf(stderr, " SFI0=0x%llx [", (unsigned long long)f);
+   for (unsigned i = 0; i < 64; i++)
+      if (f & (1ull << i))
+         fprintf(stderr, " %s", i < ARRAY_SIZE(names) ? names[i] : "bit?");
+   fprintf(stderr, " ]");
+}
+
+static void log_dxil(const char *label, const D3D12_SHADER_BYTECODE *bc, const struct dxil_info *d) {
+   char sha[65] = "-";
+   if (bc && bc->pShaderBytecode && bc->BytecodeLength)
+      sha256_hex(bc->pShaderBytecode, bc->BytecodeLength, sha);
+   fprintf(stderr, B "DXIL %s: %zu B sha256 %s container=%s", label, bc ? (size_t)bc->BytecodeLength : 0, sha, d->ok ? "DXBC" : "INVALID");
+   if (!d->ok) {
+      fprintf(stderr, "\n");
+      return;
+   }
+   fprintf(stderr, " digest=");
+   for (int i = 0; i < 16; i++)
+      fprintf(stderr, "%02x", d->digest[i]);
+   fprintf(stderr, " program kind=%u sm=%u.%u", d->prog_version >> 16, (d->prog_version >> 4) & 0xF, d->prog_version & 0xF);
+   if (d->has_sfi0)
+      log_sfi0(d->sfi0);
+   else
+      fprintf(stderr, " SFI0=absent");
+   fprintf(stderr, " psv_runtime=%u B\n", d->psv_size);
+   for (unsigned i = 0; i < d->nin; i++)
+      fprintf(stderr, B "  %s in [%u] %s%u sv=%s(%u) comp=%s reg=%u mask=0x%x always_reads=0x%x\n", label, i, d->in[i].name, d->in[i].sem_index,
+              sv_name(d->in[i].sv), d->in[i].sv, comp_name(d->in[i].comp), d->in[i].reg, d->in[i].mask, d->in[i].rw);
+   for (unsigned i = 0; i < d->nout; i++)
+      fprintf(stderr, B "  %s out[%u] %s%u sv=%s(%u) comp=%s reg=%u mask=0x%x never_writes=0x%x\n", label, i, d->out[i].name, d->out[i].sem_index,
+              sv_name(d->out[i].sv), d->out[i].sv, comp_name(d->out[i].comp), d->out[i].reg, d->out[i].mask, d->out[i].rw);
+   for (unsigned i = 0; i < d->npin; i++)
+      fprintf(stderr, B "  %s psv in [%u] %s rows=%u start_row=%u cols=%u start_col=%u kind=%u comp=%u interp=%s(%u)\n", label, i, d->pin[i].name,
+              d->pin[i].rows, d->pin[i].start_row, d->pin[i].cols, d->pin[i].start_col, d->pin[i].kind, d->pin[i].comp, interp_name(d->pin[i].interp),
+              d->pin[i].interp);
+   for (unsigned i = 0; i < d->npout; i++)
+      fprintf(stderr, B "  %s psv out[%u] %s rows=%u start_row=%u cols=%u start_col=%u kind=%u comp=%u interp=%s(%u)\n", label, i, d->pout[i].name,
+              d->pout[i].rows, d->pout[i].start_row, d->pout[i].cols, d->pout[i].start_col, d->pout[i].kind, d->pout[i].comp,
+              interp_name(d->pout[i].interp), d->pout[i].interp);
+   static const char *rt[] = { "invalid", "Sampler", "CBV", "SRVTyped", "SRVRaw", "SRVStructured", "UAVTyped", "UAVRaw", "UAVStructured",
+                               "UAVStructuredWithCounter" };
+   fprintf(stderr, B "  %s resources referenced: %u (bind-info stride %u)\n", label, d->nres, d->res_stride);
+   for (unsigned i = 0; i < d->nres; i++)
+      fprintf(stderr, B "    res[%u] %s(%u) space=%u registers %u..%u\n", i, d->res[i].type < ARRAY_SIZE(rt) ? rt[d->res[i].type] : "?",
+              d->res[i].type, d->res[i].space, d->res[i].lo, d->res[i].hi);
+}
+
+/* PS inputs must be produced by the VS at the same register with the same semantic (system-generated PS inputs excepted).
+ * Returns the number of mismatches; each one is logged. */
+static unsigned check_link(const char *label, const struct dxil_info *vs, const struct dxil_info *ps) {
+   unsigned bad = 0;
+   bool pos = false;
+   for (unsigned o = 0; o < vs->nout; o++)
+      pos |= vs->out[o].sv == 1;
+   if (!pos)
+      ++bad, fprintf(stderr, B "  link %s: VS has NO SV_Position output\n", label);
+   for (unsigned i = 0; i < ps->nin; i++) {
+      const struct sig_elem *in = &ps->in[i];
+      if (in->sv == 7 || in->sv == 9 || in->sv == 10)
+         continue; /* SV_PrimitiveID / SV_IsFrontFace / SV_SampleIndex: system-generated */
+      const struct sig_elem *match = NULL;
+      for (unsigned o = 0; o < vs->nout && !match; o++)
+         if (vs->out[o].reg == in->reg && vs->out[o].sem_index == in->sem_index && !_stricmp(vs->out[o].name, in->name))
+            match = &vs->out[o];
+      if (!match) {
+         ++bad;
+         fprintf(stderr, B "  link %s: PS input %s%u reg=%u mask=0x%x has NO matching VS output (same semantic + register)\n", label, in->name,
+                 in->sem_index, in->reg, in->mask);
+      } else if ((in->mask & ~match->mask) || match->comp != in->comp || match->sv != in->sv) {
+         ++bad;
+         fprintf(stderr, B "  link %s: PS input %s%u reg=%u mask=0x%x comp=%s sv=%u vs VS output mask=0x%x comp=%s sv=%u: MISMATCH\n", label, in->name,
+                 in->sem_index, in->reg, in->mask, comp_name(in->comp), in->sv, match->mask, comp_name(match->comp), match->sv);
+      }
+   }
+   fprintf(stderr, B "  link %s: %u mismatch(es) over %u PS inputs / %u VS outputs\n", label, bad, ps->nin, vs->nout);
+   return bad;
+}
+
+/* non-system VS inputs must be fed by an input-layout element with the same semantic */
+static unsigned check_layout(const char *label, const struct dxil_info *vs, const D3D12_INPUT_LAYOUT_DESC *il) {
+   unsigned bad = 0;
+   for (unsigned i = 0; i < vs->nin; i++) {
+      if (vs->in[i].sv)
+         continue;
+      bool found = false;
+      for (UINT e = 0; il && e < il->NumElements && !found; e++)
+         found = il->pInputElementDescs[e].SemanticIndex == vs->in[i].sem_index && !_stricmp(il->pInputElementDescs[e].SemanticName, vs->in[i].name);
+      if (!found)
+         ++bad, fprintf(stderr, B "  layout %s: VS input %s%u reg=%u has NO input-layout element\n", label, vs->in[i].name, vs->in[i].sem_index, vs->in[i].reg);
+   }
+   fprintf(stderr, B "  layout %s: %u missing over %u VS inputs / %u layout elements\n", label, bad, vs->nin, il ? il->NumElements : 0);
+   return bad;
+}
+
+/* ---- root-signature registry (filled by dzn_device_create_root_sig) ---- */
+struct rs_range { uint8_t kind; uint32_t space, lo, hi; }; /* kind: 0 SRV, 1 UAV, 2 CBV, 3 SAMPLER (D3D12_DESCRIPTOR_RANGE_TYPE order) */
+struct rs_entry {
+   const void *sig;
+   char text[2048];
+   unsigned nranges;
+   struct rs_range ranges[64];
+};
+static struct rs_entry g_rs[256]; /* M7B.3: 32 was filled by dzn meta pipelines first */
+static volatile long g_rs_count;
+
+static void rs_add(struct rs_entry *r, uint8_t kind, uint32_t space, uint32_t base, uint32_t num) {
+   if (r->nranges < ARRAY_SIZE(r->ranges))
+      r->ranges[r->nranges++] = (struct rs_range){ kind, space, base, num == UINT_MAX ? UINT_MAX : base + num - 1 };
+}
+
+void vitox_pso_root_sig_created(const D3D12_VERSIONED_ROOT_SIGNATURE_DESC *desc, const void *sig) {
+   const long slot = InterlockedIncrement(&g_rs_count) - 1;
+   if (slot >= (long)ARRAY_SIZE(g_rs) || !desc)
+      return;
+   struct rs_entry *r = &g_rs[slot];
+   r->nranges = 0;
+   size_t n = 0;
+#define APP(...) (n += (size_t)snprintf(r->text + n, n < sizeof(r->text) ? sizeof(r->text) - n : 0, __VA_ARGS__), n = MIN2(n, sizeof(r->text) - 1))
+   static const char *rk[] = { "SRV", "UAV", "CBV", "SAMPLER" };
+   if (desc->Version == D3D_ROOT_SIGNATURE_VERSION_1_1 || desc->Version == D3D_ROOT_SIGNATURE_VERSION_1_2) {
+      /* Desc_1_1 and Desc_1_2 share NumParameters / pParameters (D3D12_ROOT_PARAMETER1) / NumStaticSamplers / pStaticSamplers / Flags;
+       * the static sampler struct differs (DESC vs DESC1) but starts with the same fields up to RegisterSpace/ShaderVisibility */
+      const D3D12_ROOT_SIGNATURE_DESC1 *d = &desc->Desc_1_1;
+      APP("version=0x%x flags=0x%x params=%u static_samplers=%u", desc->Version, d->Flags, d->NumParameters, d->NumStaticSamplers);
+      for (UINT p = 0; p < d->NumParameters; p++) {
+         const D3D12_ROOT_PARAMETER1 *rp = &d->pParameters[p];
+         switch (rp->ParameterType) {
+         case D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE:
+            APP(" | p%u TABLE vis=%d ranges=%u:", p, rp->ShaderVisibility, rp->DescriptorTable.NumDescriptorRanges);
+            for (UINT i = 0; i < rp->DescriptorTable.NumDescriptorRanges; i++) {
+               const D3D12_DESCRIPTOR_RANGE1 *dr = &rp->DescriptorTable.pDescriptorRanges[i];
+               APP(" %s(n=%d base=%u space=%u off=%u flags=0x%x)", dr->RangeType < 4 ? rk[dr->RangeType] : "?", (int)dr->NumDescriptors,
+                   dr->BaseShaderRegister, dr->RegisterSpace, dr->OffsetInDescriptorsFromTableStart, dr->Flags);
+               rs_add(r, (uint8_t)dr->RangeType, dr->RegisterSpace, dr->BaseShaderRegister, dr->NumDescriptors);
+            }
+            break;
+         case D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS:
+            APP(" | p%u CONSTANTS vis=%d b%u space=%u num32=%u", p, rp->ShaderVisibility, rp->Constants.ShaderRegister, rp->Constants.RegisterSpace,
+                rp->Constants.Num32BitValues);
+            rs_add(r, D3D12_DESCRIPTOR_RANGE_TYPE_CBV, rp->Constants.RegisterSpace, rp->Constants.ShaderRegister, 1);
+            break;
+         case D3D12_ROOT_PARAMETER_TYPE_CBV:
+         case D3D12_ROOT_PARAMETER_TYPE_SRV:
+         case D3D12_ROOT_PARAMETER_TYPE_UAV: {
+            const uint8_t kind = rp->ParameterType == D3D12_ROOT_PARAMETER_TYPE_CBV ? 2 : rp->ParameterType == D3D12_ROOT_PARAMETER_TYPE_SRV ? 0 : 1;
+            APP(" | p%u ROOT_%s vis=%d reg=%u space=%u", p, rk[kind], rp->ShaderVisibility, rp->Descriptor.ShaderRegister, rp->Descriptor.RegisterSpace);
+            rs_add(r, kind, rp->Descriptor.RegisterSpace, rp->Descriptor.ShaderRegister, 1);
+            break;
+         }
+         default:
+            APP(" | p%u type=%d", p, rp->ParameterType);
+            break;
+         }
+      }
+      const size_t ss_stride = desc->Version == D3D_ROOT_SIGNATURE_VERSION_1_2 ? sizeof(D3D12_STATIC_SAMPLER_DESC1) : sizeof(D3D12_STATIC_SAMPLER_DESC);
+      for (UINT i = 0; i < d->NumStaticSamplers; i++) {
+         const D3D12_STATIC_SAMPLER_DESC *ss = (const void *)((const uint8_t *)d->pStaticSamplers + i * ss_stride);
+         APP(" | static_sampler s%u space=%u vis=%d", ss->ShaderRegister, ss->RegisterSpace, ss->ShaderVisibility);
+         rs_add(r, D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER, ss->RegisterSpace, ss->ShaderRegister, 1);
+      }
+   } else {
+      APP("version=0x%x (not decoded)", desc->Version);
+   }
+#undef APP
+   r->sig = sig; /* published last */
+   fprintf(stderr, "[vitox-pso] root signature %p created: %s\n", sig, r->text);
+   fflush(stderr);
+}
+
+static const struct rs_entry *rs_find(const void *sig) {
+   const long n = MIN2(g_rs_count, (long)ARRAY_SIZE(g_rs));
+   for (long i = n - 1; i >= 0; i--)
+      if (g_rs[i].sig == sig)
+         return &g_rs[i];
+   return NULL;
+}
+
+/* every resource the DXIL references must sit inside a root-signature range of the same class */
+static unsigned check_bindings(const char *label, const struct dxil_info *d, const struct rs_entry *r, bool bindless) {
+   unsigned bad = 0;
+   for (unsigned i = 0; i < d->nres; i++) {
+      const uint32_t t = d->res[i].type;
+      const int kind = t == 1 ? 3 : t == 2 ? 2 : (t >= 3 && t <= 5) ? 0 : (t >= 6 && t <= 9) ? 1 : -1;
+      bool ok = false;
+      for (unsigned k = 0; r && k < r->nranges && !ok; k++)
+         ok = r->ranges[k].kind == kind && r->ranges[k].space == d->res[i].space && d->res[i].lo >= r->ranges[k].lo && d->res[i].hi <= r->ranges[k].hi;
+      if (!ok)
+         ++bad, fprintf(stderr, B "  bindings %s: res[%u] type=%u space=%u %u..%u is NOT represented in the root signature%s\n", label, i, t,
+                        d->res[i].space, d->res[i].lo, d->res[i].hi, bindless ? " (device is bindless: heap-indexed access may not need a range)" : "");
+   }
+   fprintf(stderr, B "  bindings %s: %u of %u referenced resources unrepresented (root signature %s)\n", label, bad, d->nres, r ? "known" : "NOT IN REGISTRY");
+   return bad;
+}
+
+/* ---- the differential control's pair, copied from the first successful base-path PSO without an input layout ---- */
+static struct {
+   bool captured;
+   D3D12_SHADER_BYTECODE vs, ps;
+   ID3D12RootSignature *root_sig;
+} g_ctl;
+
+static void capture_control(const char *path, HRESULT hr, const D3D12_PIPELINE_STATE_STREAM_DESC *stream) {
+   if (g_ctl.captured || strcmp(path, "base") || FAILED(hr))
+      return;
+   struct stream_map m;
+   map_stream(stream->pPipelineStateSubobjectStream, stream->SizeInBytes, &m);
+   const D3D12_INPUT_LAYOUT_DESC *il = DESC(stream->pPipelineStateSubobjectStream, m, INPUT_LAYOUT, D3D12_INPUT_LAYOUT_DESC);
+   const D3D12_SHADER_BYTECODE *vs = DESC(stream->pPipelineStateSubobjectStream, m, VS, D3D12_SHADER_BYTECODE);
+   const D3D12_SHADER_BYTECODE *ps = DESC(stream->pPipelineStateSubobjectStream, m, PS, D3D12_SHADER_BYTECODE);
+   ID3D12RootSignature *const *rs = DESC(stream->pPipelineStateSubobjectStream, m, ROOT_SIGNATURE, ID3D12RootSignature *);
+   if ((il && il->NumElements) || !vs || !ps || !vs->BytecodeLength || !ps->BytecodeLength)
+      return;
+   void *v = malloc(vs->BytecodeLength), *p = malloc(ps->BytecodeLength);
+   if (!v || !p) {
+      free(v), free(p);
+      return;
+   }
+   memcpy(v, vs->pShaderBytecode, vs->BytecodeLength);
+   memcpy(p, ps->pShaderBytecode, ps->BytecodeLength);
+   g_ctl.vs = (D3D12_SHADER_BYTECODE){ v, vs->BytecodeLength };
+   g_ctl.ps = (D3D12_SHADER_BYTECODE){ p, ps->BytecodeLength };
+   g_ctl.root_sig = rs ? *rs : NULL;
+   if (g_ctl.root_sig)
+      ID3D12RootSignature_AddRef(g_ctl.root_sig);
+   g_ctl.captured = true;
+   fprintf(stderr, "[vitox-pso] M7B.2: captured the differential control pair (VS %zu B, PS %zu B, root signature %p) for the bisect\n",
+           (size_t)vs->BytecodeLength, (size_t)ps->BytecodeLength, (void *)g_ctl.root_sig);
+   fflush(stderr);
+}
+
+/* ---- format support ---- */
+static void log_format(struct dzn_device *device, DXGI_FORMAT f, const char *name) {
+   D3D12_FEATURE_DATA_FORMAT_SUPPORT fs = { .Format = f };
+   const HRESULT hr = ID3D12Device4_CheckFeatureSupport(device->dev, D3D12_FEATURE_FORMAT_SUPPORT, &fs, sizeof(fs));
+   D3D12_FEATURE_DATA_MULTISAMPLE_QUALITY_LEVELS ms = { .Format = f, .SampleCount = 1 };
+   const HRESULT hr2 = ID3D12Device4_CheckFeatureSupport(device->dev, D3D12_FEATURE_MULTISAMPLE_QUALITY_LEVELS, &ms, sizeof(ms));
+   const UINT s1 = fs.Support1;
+   fprintf(stderr,
+           B "format %-22s (%2d): hr=0x%08lx Support1=0x%08x Support2=0x%08x | TEXTURE2D=%d RENDER_TARGET=%d BLENDABLE=%d DEPTH_STENCIL=%d SHADER_LOAD=%d "
+             "SHADER_SAMPLE=%d MULTISAMPLE_RT=%d | ms(count=1) hr=0x%08lx quality_levels=%u\n",
+           name, f, (unsigned long)hr, s1, (unsigned)fs.Support2, !!(s1 & D3D12_FORMAT_SUPPORT1_TEXTURE2D), !!(s1 & D3D12_FORMAT_SUPPORT1_RENDER_TARGET),
+           !!(s1 & D3D12_FORMAT_SUPPORT1_BLENDABLE), !!(s1 & D3D12_FORMAT_SUPPORT1_DEPTH_STENCIL), !!(s1 & D3D12_FORMAT_SUPPORT1_SHADER_LOAD),
+           !!(s1 & D3D12_FORMAT_SUPPORT1_SHADER_SAMPLE), !!(s1 & D3D12_FORMAT_SUPPORT1_MULTISAMPLE_RENDERTARGET), (unsigned long)hr2,
+           ms.NumQualityLevels);
+}
+
+/* ---- the bisect ---- */
+#define N_TESTS 15
+
+void vitox_pso_bisect(struct dzn_device *device, const D3D12_PIPELINE_STATE_STREAM_DESC *failed) {
+   static volatile long once;
+   if (InterlockedIncrement(&once) != 1)
+      return;
+   struct dzn_physical_device *pdev = container_of(device->vk.physical, struct dzn_physical_device, vk);
+   fprintf(stderr, B "==== M7B.2 DIAGNOSTIC PSO FIELD BISECT (copies only; the real variant stays NULL and contained) ====\n");
+   fprintf(stderr, B "device: shader_model=0x%x root_sig_version=0x%x bindless=%d ViewInstancingTier=%d IndependentFrontAndBackStencilRefMask=%d "
+                     "DynamicDepthBias=%d Native16Bit=%d Int64ShaderOps=%d ROVs=%d StencilRef(PSSpecifiedStencilRef)=%d TypedUAVLoadAdditionalFormats=%d\n",
+           pdev->shader_model, pdev->root_sig_version, device->bindless, pdev->options3.ViewInstancingTier,
+           pdev->options14.IndependentFrontAndBackStencilRefMaskSupported, pdev->options16.DynamicDepthBiasSupported, pdev->options4.Native16BitShaderOpsSupported,
+           pdev->options1.Int64ShaderOps, pdev->options.ROVsSupported, pdev->options.PSSpecifiedStencilRefSupported,
+           pdev->options.TypedUAVLoadAdditionalFormats);
+
+   /* 2. format support */
+   log_format(device, DXGI_FORMAT_R8G8B8A8_UNORM, "R8G8B8A8_UNORM");
+   log_format(device, DXGI_FORMAT_B8G8R8A8_UNORM, "B8G8R8A8_UNORM");
+   log_format(device, DXGI_FORMAT_D32_FLOAT_S8X24_UINT, "D32_FLOAT_S8X24_UINT");
+   log_format(device, DXGI_FORMAT_D24_UNORM_S8_UINT, "D24_UNORM_S8_UINT");
+   log_format(device, DXGI_FORMAT_D32_FLOAT, "D32_FLOAT");
+
+   const size_t size = failed->SizeInBytes;
+   if (size > MAX_GFX_PIPELINE_STATE_STREAM_SIZE) {
+      fprintf(stderr, B "stream too large (%zu) - bisect aborted\n", size);
+      fflush(stderr);
+      return;
+   }
+   struct stream_map m;
+   map_stream(failed->pPipelineStateSubobjectStream, size, &m);
+   const void *fs = failed->pPipelineStateSubobjectStream;
+   const D3D12_SHADER_BYTECODE *fvs = DESC(fs, m, VS, D3D12_SHADER_BYTECODE), *fps = DESC(fs, m, PS, D3D12_SHADER_BYTECODE);
+   const D3D12_INPUT_LAYOUT_DESC *fil = DESC(fs, m, INPUT_LAYOUT, D3D12_INPUT_LAYOUT_DESC);
+   const vitox_rt_format_array *frt = DESC(fs, m, RENDER_TARGET_FORMATS, vitox_rt_format_array);
+   ID3D12RootSignature *const *frs = DESC(fs, m, ROOT_SIGNATURE, ID3D12RootSignature *);
+
+   /* 4. DXIL signature inventory + linkage */
+   static struct dxil_info dvs, dps, cvs, cps; /* large: keep off the stack */
+   inspect_dxil(fvs, &dvs);
+   inspect_dxil(fps, &dps);
+   inspect_dxil(g_ctl.captured ? &g_ctl.vs : NULL, &cvs);
+   inspect_dxil(g_ctl.captured ? &g_ctl.ps : NULL, &cps);
+   log_dxil("failing VS", fvs, &dvs);
+   log_dxil("failing PS", fps, &dps);
+   if (g_ctl.captured) {
+      log_dxil("control VS", &g_ctl.vs, &cvs);
+      log_dxil("control PS", &g_ctl.ps, &cps);
+   } else {
+      fprintf(stderr, B "control pair NOT captured: tests 10-14 will be SKIPPED\n");
+   }
+   check_link("failing VS -> failing PS", &dvs, &dps);
+   check_layout("failing VS <- failed input layout", &dvs, fil);
+   for (unsigned i = 0; i < dps.nout; i++)
+      if (dps.out[i].sv == 64)
+         fprintf(stderr, B "  failing PS writes SV_Target%u (reg %u, comp=%s, mask=0x%x) | RTV count=%u format[%u]=%d\n", dps.out[i].sem_index,
+                 dps.out[i].reg, comp_name(dps.out[i].comp), dps.out[i].mask, frt ? frt->NumRenderTargets : 0, dps.out[i].reg,
+                 frt && dps.out[i].reg < 8 ? frt->RTFormats[dps.out[i].reg] : -1);
+   const unsigned link10 = g_ctl.captured ? check_link("control VS -> failing PS (test 10)", &cvs, &dps) : 1;
+   const unsigned layout10 = g_ctl.captured ? check_layout("control VS <- failed input layout (test 10)", &cvs, fil) : 1;
+   const unsigned link11 = g_ctl.captured ? check_link("failing VS -> control PS (test 11)", &dvs, &cps) : 1;
+   if (g_ctl.captured)
+      check_link("control VS -> control PS (tests 12/13)", &cvs, &cps);
+
+   /* 5. root signature / binding summary */
+   const void *fsig = frs ? *frs : NULL;
+   const struct rs_entry *fr = rs_find(fsig), *cr = g_ctl.captured ? rs_find(g_ctl.root_sig) : NULL;
+   fprintf(stderr, B "failing root signature %p: %s\n", fsig, fr ? fr->text : "(not in registry)");
+   if (g_ctl.captured)
+      fprintf(stderr, B "control root signature %p: %s\n", (void *)g_ctl.root_sig, cr ? cr->text : "(not in registry)");
+   check_bindings("failing VS", &dvs, fr, device->bindless);
+   check_bindings("failing PS", &dps, fr, device->bindless);
+   if (g_ctl.captured) {
+      check_bindings("control VS vs failing root sig (test 12)", &cvs, fr, device->bindless);
+      check_bindings("control PS vs failing root sig (test 12)", &cps, fr, device->bindless);
+   }
+   fflush(stderr);
+
+   /* 3. the matrix: each test starts again from an exact copy of the failed stream */
+   static const char *what[N_TESTS] = {
+      "BASE exact copy, no changes",
+      "stencil disabled (depth + DSV kept)",
+      "depth disabled (stencil + DSV kept)",
+      "depth + stencil disabled (DSV kept)",
+      "depth + stencil disabled + DSV UNKNOWN",
+      "stencil ReadMask 0x00 -> 0xFF only",
+      "stencil WriteMask 0xFF -> 0x00 only",
+      "DSV D32_FLOAT_S8X24_UINT -> D24_UNORM_S8_UINT only",
+      "stencil disabled + DSV -> D32_FLOAT (depth kept)",
+      "RTV R8G8B8A8_UNORM -> B8G8R8A8_UNORM only",
+      "VS only -> control VS",
+      "PS only -> control PS",
+      "VS+PS -> control pair + control input layout (no elements); failed DS/RTV kept",
+      "VS+PS -> control pair + control input layout; depth/stencil disabled + DSV UNKNOWN",
+      "root signature -> control root signature (Vita3K shaders kept) [conditional]",
+   };
+   HRESULT res[N_TESTS];
+   bool ran[N_TESTS] = { 0 };
+   uintptr_t buf[MAX_GFX_PIPELINE_STATE_STREAM_SIZE / sizeof(uintptr_t)];
+   for (int t = 0; t < N_TESTS; t++) {
+      memcpy(buf, fs, size);
+      D3D12_DEPTH_STENCIL_DESC1 *ds1 = DESC(buf, m, DEPTH_STENCIL1, D3D12_DEPTH_STENCIL_DESC1);
+      D3D12_DEPTH_STENCIL_DESC2 *ds2 = DESC(buf, m, DEPTH_STENCIL2, D3D12_DEPTH_STENCIL_DESC2);
+      D3D12_DEPTH_STENCIL_DESC *ds0 = DESC(buf, m, DEPTH_STENCIL, D3D12_DEPTH_STENCIL_DESC);
+      DXGI_FORMAT *dsv = DESC(buf, m, DEPTH_STENCIL_FORMAT, DXGI_FORMAT);
+      vitox_rt_format_array *rt = DESC(buf, m, RENDER_TARGET_FORMATS, vitox_rt_format_array);
+      D3D12_SHADER_BYTECODE *vs = DESC(buf, m, VS, D3D12_SHADER_BYTECODE), *ps = DESC(buf, m, PS, D3D12_SHADER_BYTECODE);
+      D3D12_INPUT_LAYOUT_DESC *il = DESC(buf, m, INPUT_LAYOUT, D3D12_INPUT_LAYOUT_DESC);
+      ID3D12RootSignature **rs = DESC(buf, m, ROOT_SIGNATURE, ID3D12RootSignature *);
+      const bool has_ds = ds1 || ds2 || ds0;
+#define SET_DS(field, v) do { if (ds1) ds1->field = (v); if (ds2) ds2->field = (v); if (ds0) ds0->field = (v); } while (0)
+      const char *skip = NULL;
+      char why[200] = "";
+      switch (t) {
+      case 0: break;
+      case 1: if (!has_ds) skip = "no depth-stencil subobject"; else SET_DS(StencilEnable, FALSE); break;
+      case 2: if (!has_ds) skip = "no depth-stencil subobject"; else SET_DS(DepthEnable, FALSE); break;
+      case 3: if (!has_ds) skip = "no depth-stencil subobject"; else { SET_DS(DepthEnable, FALSE); SET_DS(StencilEnable, FALSE); } break;
+      case 4:
+         if (!has_ds || !dsv) skip = "no depth-stencil / DSV-format subobject";
+         else { SET_DS(DepthEnable, FALSE); SET_DS(StencilEnable, FALSE); *dsv = DXGI_FORMAT_UNKNOWN; }
+         break;
+      case 5:
+         if (ds1) ds1->StencilReadMask = 0xFF;
+         else if (ds0) ds0->StencilReadMask = 0xFF;
+         else if (ds2) ds2->FrontFace.StencilReadMask = ds2->BackFace.StencilReadMask = 0xFF;
+         else skip = "no depth-stencil subobject";
+         break;
+      case 6:
+         if (ds1) ds1->StencilWriteMask = 0x00;
+         else if (ds0) ds0->StencilWriteMask = 0x00;
+         else if (ds2) ds2->FrontFace.StencilWriteMask = ds2->BackFace.StencilWriteMask = 0x00;
+         else skip = "no depth-stencil subobject";
+         break;
+      case 7: if (!dsv) skip = "no DSV-format subobject"; else *dsv = DXGI_FORMAT_D24_UNORM_S8_UINT; break;
+      case 8: if (!has_ds || !dsv) skip = "no depth-stencil / DSV-format subobject"; else { SET_DS(StencilEnable, FALSE); *dsv = DXGI_FORMAT_D32_FLOAT; } break;
+      case 9: if (!rt || !rt->NumRenderTargets) skip = "no render target"; else rt->RTFormats[0] = DXGI_FORMAT_B8G8R8A8_UNORM; break;
+      case 10:
+         if (!g_ctl.captured || !vs) skip = "control pair not captured";
+         else if (link10 || layout10) {
+            snprintf(why, sizeof(why), "control VS cannot feed the failing PS structurally (%u link mismatch(es), %u layout gap(s)) - no invalid control built",
+                     link10, layout10);
+            skip = why;
+         } else *vs = g_ctl.vs;
+         break;
+      case 11:
+         if (!g_ctl.captured || !ps) skip = "control pair not captured";
+         else if (link11) {
+            snprintf(why, sizeof(why), "failing VS cannot feed the control PS structurally (%u link mismatch(es)) - no invalid control built", link11);
+            skip = why;
+         } else *ps = g_ctl.ps;
+         break;
+      case 12:
+      case 13:
+         if (!g_ctl.captured || !vs || !ps) { skip = "control pair not captured"; break; }
+         *vs = g_ctl.vs, *ps = g_ctl.ps;
+         if (il)
+            il->NumElements = 0, il->pInputElementDescs = NULL;
+         if (t == 13) {
+            if (!has_ds || !dsv) { skip = "no depth-stencil / DSV-format subobject"; break; }
+            SET_DS(DepthEnable, FALSE);
+            SET_DS(StencilEnable, FALSE);
+            *dsv = DXGI_FORMAT_UNKNOWN;
+         }
+         break;
+      case 14: {
+         /* only when the shader-pair tests implicate shaders/root signature: every ran test 1..9 failed and 12 or 13 succeeded */
+         bool all_fail = true;
+         for (int k = 1; k <= 9; k++)
+            all_fail &= !ran[k] || FAILED(res[k]);
+         const bool shader_ok = (ran[12] && SUCCEEDED(res[12])) || (ran[13] && SUCCEEDED(res[13]));
+         if (!all_fail || !shader_ok)
+            skip = "NOT RUN by rule: tests 1-9 did not all fail, or neither 12 nor 13 succeeded";
+         else if (!rs || !g_ctl.root_sig)
+            skip = "no control root signature";
+         else
+            *rs = g_ctl.root_sig;
+         break;
+      }
+      }
+#undef SET_DS
+      if (skip) {
+         fprintf(stderr, B "test %2d SKIPPED: %s | %s\n", t, what[t], skip);
+         continue;
+      }
+      ID3D12PipelineState *state = NULL;
+      const D3D12_PIPELINE_STATE_STREAM_DESC desc = { .SizeInBytes = size, .pPipelineStateSubobjectStream = buf };
+      res[t] = ID3D12Device4_CreatePipelineState(device->dev, &desc, &IID_ID3D12PipelineState, (void **)&state);
+      ran[t] = true;
+      const HRESULT removed = ID3D12Device_GetDeviceRemovedReason(device->dev);
+      fprintf(stderr, B "test %2d hr=0x%08lx %s removed=0x%08lx | %s\n", t, (unsigned long)res[t], SUCCEEDED(res[t]) ? "S_OK      " : "FAILED    ",
+              (unsigned long)removed, what[t]);
+      if (state)
+         ID3D12PipelineState_Release(state); /* diagnostic PSO: released immediately, never used */
+      fflush(stderr);
+   }
+
+   fprintf(stderr, B "SUMMARY:");
+   for (int t = 0; t < N_TESTS; t++)
+      fprintf(stderr, " t%d=%s", t, !ran[t] ? "skip" : SUCCEEDED(res[t]) ? "OK" : "FAIL");
+   fprintf(stderr, "\n" B "==== M7B.2 bisect done: the real variant was NOT modified and stays NULL ====\n");
+   fflush(stderr);
+}
