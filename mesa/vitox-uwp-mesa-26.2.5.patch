index 0000000..1f22af7
--- /dev/null
+++ b/C:/Vitox/Vitox-M6/mesa/src/microsoft/vulkan/vitox_pso_diag.h
@@ -0,0 +1,30 @@
+/* Vitox M7B.1 (VITOX_UWP only): LOGGING-ONLY diagnostics for D3D12 pipeline-state creation in dzn.
+ * Writes to stderr (the Vitox app redirects it to LocalState). Nothing here changes a PSO, a stream or a result.
+ * The only behavioural addition (in dzn_cmd_buffer.c) is the labelled DIAGNOSTIC CONTAINMENT: a draw whose
+ * pipeline has no D3D12 state is not issued to D3D12 and is counted in vitox_dzn_pso_failures, which the probe
+ * polls to stop rendering immediately. */
+#ifndef VITOX_PSO_DIAG_H
+#define VITOX_PSO_DIAG_H
+#ifdef VITOX_UWP
+
+#include "dzn_private.h"
+
+/* incremented for every draw skipped because the bound pipeline has no ID3D12PipelineState */
+extern __declspec(dllexport) volatile long vitox_dzn_pso_failures;
+
+/* Log one CreatePipelineState attempt: path ("base" / "variant"), HRESULT, device-removed reason, the variant key
+ * (NULL for the base path), and every subobject of the stream in order. */
+void vitox_pso_log_create(struct dzn_device *device, const char *path, HRESULT hr, const D3D12_PIPELINE_STATE_STREAM_DESC *stream,
+                          const struct dzn_graphics_pipeline_variant_key *key, const void *result_state);
+
+/* ---- Vitox M7B.2 (VITOX_UWP only): DIAGNOSTIC field bisect. Never changes the real pipeline, stream or result. ---- */
+
+/* dzn_device_create_root_sig: remember the root-signature layout (params, ranges, static samplers) for the bisect report */
+void vitox_pso_root_sig_created(const D3D12_VERSIONED_ROOT_SIGNATURE_DESC *desc, const void *sig);
+
+/* first failed variant: format support, DXIL signature/resource inventory, root-signature summary, then CreatePipelineState
+ * on modified COPIES of the failed stream (tests 0..14). Every diagnostic PSO is released immediately. Runs once. */
+void vitox_pso_bisect(struct dzn_device *device, const D3D12_PIPELINE_STATE_STREAM_DESC *failed);
+
+#endif
+#endif
diff --git a/C:/Vitox/Vitox-M6/mesa/src/microsoft/vulkan/vitox_pso_diag.c b/C:/Vitox/Vitox-M6/mesa/src/microsoft/vulkan/vitox_pso_diag.c
new file mode 100644
index 0000000..6bf88a3
--- /dev/null
+++ b/C:/Vitox/Vitox-M6/mesa/src/microsoft/vulkan/vitox_pso_diag.c
@@ -0,0 +1,900 @@
+/* Vitox M7B.1 (VITOX_UWP only): LOGGING-ONLY D3D12 PSO diagnostics for dzn - see vitox_pso_diag.h. */
+#ifdef VITOX_UWP
+
+#include "vitox_pso_diag.h"
+
+#include <stdio.h>
+#include <string.h>
+
+__declspec(dllexport) volatile long vitox_dzn_pso_failures = 0;
+
+/* M7B.2: keeps a copy of the differential control's DXIL pair + root signature (defined below) */
+static void capture_control(const char *path, HRESULT hr, const D3D12_PIPELINE_STATE_STREAM_DESC *stream);
+/* M7B.3: SFI0 feature flags of a DXIL blob (defined below); false if absent */
+static bool dxil_sfi0(const D3D12_SHADER_BYTECODE *bc, uint64_t *flags);
+
+/* ---- SHA-256 (FIPS 180-4), for DXIL blob identification only ---- */
+static const uint32_t k_sha[64] = {
+   0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be,
+   0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa,
+   0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85,
+   0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+   0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f,
+   0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2 };
+#define ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+static void sha_block(uint32_t h[8], const uint8_t *p) {
+   uint32_t w[64];
+   for (int i = 0; i < 16; i++)
+      w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+   for (int i = 16; i < 64; i++) {
+      const uint32_t s0 = ROR(w[i - 15], 7) ^ ROR(w[i - 15], 18) ^ (w[i - 15] >> 3), s1 = ROR(w[i - 2], 17) ^ ROR(w[i - 2], 19) ^ (w[i - 2] >> 10);
+      w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+   }
+   uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
+   for (int i = 0; i < 64; i++) {
+      const uint32_t t1 = hh + (ROR(e, 6) ^ ROR(e, 11) ^ ROR(e, 25)) + ((e & f) ^ (~e & g)) + k_sha[i] + w[i];
+      const uint32_t t2 = (ROR(a, 2) ^ ROR(a, 13) ^ ROR(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+      hh = g, g = f, f = e, e = d + t1, d = c, c = b, b = a, a = t1 + t2;
+   }
+   h[0] += a, h[1] += b, h[2] += c, h[3] += d, h[4] += e, h[5] += f, h[6] += g, h[7] += hh;
+}
+static void sha256_hex(const void *data, size_t size, char out[65]) {
+   uint32_t h[8] = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 };
+   const uint8_t *p = data;
+   size_t n = size;
+   for (; n >= 64; n -= 64, p += 64)
+      sha_block(h, p);
+   uint8_t tail[128] = { 0 };
+   memcpy(tail, p, n);
+   tail[n] = 0x80;
+   const size_t tlen = n < 56 ? 64 : 128;
+   const uint64_t bits = (uint64_t)size * 8;
+   for (int i = 0; i < 8; i++)
+      tail[tlen - 1 - i] = (uint8_t)(bits >> (8 * i));
+   sha_block(h, tail);
+   if (tlen == 128)
+      sha_block(h, tail + 64);
+   for (int i = 0; i < 8; i++)
+      sprintf(out + 8 * i, "%08x", h[i]);
+}
+
+static const char *subobject_name(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE t) {
+   switch (t) {
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE: return "ROOT_SIGNATURE";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS: return "VS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS: return "PS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DS: return "DS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_HS: return "HS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_GS: return "GS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CS: return "CS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_STREAM_OUTPUT: return "STREAM_OUTPUT";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND: return "BLEND";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_MASK: return "SAMPLE_MASK";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER: return "RASTERIZER";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL: return "DEPTH_STENCIL";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_INPUT_LAYOUT: return "INPUT_LAYOUT";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_IB_STRIP_CUT_VALUE: return "IB_STRIP_CUT_VALUE";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY: return "PRIMITIVE_TOPOLOGY";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS: return "RENDER_TARGET_FORMATS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL_FORMAT: return "DEPTH_STENCIL_FORMAT";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_DESC: return "SAMPLE_DESC";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_NODE_MASK: return "NODE_MASK";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CACHED_PSO: return "CACHED_PSO";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_FLAGS: return "FLAGS";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL1: return "DEPTH_STENCIL1";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VIEW_INSTANCING: return "VIEW_INSTANCING";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL2: return "DEPTH_STENCIL2";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER1: return "RASTERIZER1";
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER2: return "RASTERIZER2";
+   default: return "?";
+   }
+}
+
+static void log_face(const char *which, const D3D12_DEPTH_STENCILOP_DESC *f) {
+   fprintf(stderr, "[vitox-pso]       %s: fail=%d depthfail=%d pass=%d func=%d\n", which, f->StencilFailOp, f->StencilDepthFailOp, f->StencilPassOp,
+           f->StencilFunc);
+}
+static void log_face1(const char *which, const D3D12_DEPTH_STENCILOP_DESC1 *f) {
+   fprintf(stderr, "[vitox-pso]       %s: fail=%d depthfail=%d pass=%d func=%d readmask=0x%02x writemask=0x%02x\n", which, f->StencilFailOp,
+           f->StencilDepthFailOp, f->StencilPassOp, f->StencilFunc, f->StencilReadMask, f->StencilWriteMask);
+}
+
+/* d3dx12.h (C++) type, not in C d3d12.h: same layout as the RENDER_TARGET_FORMATS subobject payload */
+typedef struct { DXGI_FORMAT RTFormats[8]; UINT NumRenderTargets; } vitox_rt_format_array;
+
+/* one wrapper per subobject: { type; desc } aligned like dzn's d3d12_pipeline_state_stream_new_desc */
+#define WRAP(T) struct { D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type; T desc; }
+#define CASE(ID, T)                                                                \
+   case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_##ID: {                                \
+      const WRAP(T) *w = (const void *)(base + off);                               \
+      size = sizeof(*w);                                                           \
+      const T *d = &w->desc;                                                       \
+      (void)d;
+
+void vitox_pso_log_create(struct dzn_device *device, const char *path, HRESULT hr, const D3D12_PIPELINE_STATE_STREAM_DESC *stream,
+                          const struct dzn_graphics_pipeline_variant_key *key, const void *result_state)
+{
+   const HRESULT removed = device ? ID3D12Device_GetDeviceRemovedReason(device->dev) : 0;
+   fprintf(stderr, "[vitox-pso] CreatePipelineState (%s path) hr=0x%08lx%s removed=0x%08lx result_state=%p stream SizeInBytes=%zu\n", path,
+           (unsigned long)hr, FAILED(hr) ? " FAILED" : "", (unsigned long)removed, result_state, (size_t)stream->SizeInBytes);
+   if (key)
+      fprintf(stderr,
+              "[vitox-pso]   variant key: ib_strip_cut=%d depth_bias{constant=%d slope=%f clamp=%f} stencil front{ref=%u compare=0x%x write=0x%x} "
+              "back{ref=%u compare=0x%x write=0x%x}\n",
+              key->ib_strip_cut, key->depth_bias.constant_factor, key->depth_bias.slope_factor, key->depth_bias.clamp,
+              key->stencil_test.front.ref, key->stencil_test.front.compare_mask, key->stencil_test.front.write_mask, key->stencil_test.back.ref,
+              key->stencil_test.back.compare_mask, key->stencil_test.back.write_mask);
+   const uint8_t *base = stream->pPipelineStateSubobjectStream;
+   size_t off = 0;
+   unsigned subidx = 0, stages = 0;
+   while (off < stream->SizeInBytes && subidx < 32) {
+      off = ALIGN_POT(off, alignof(void *));
+      if (off + sizeof(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE) > stream->SizeInBytes)
+         break;
+      const D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type = *(const D3D12_PIPELINE_STATE_SUBOBJECT_TYPE *)(base + off);
+      size_t size = 0;
+      fprintf(stderr, "[vitox-pso]   [%u] @%zu %s(%d)", subidx, off, subobject_name(type), type);
+      switch (type) {
+      CASE(ROOT_SIGNATURE, ID3D12RootSignature *) fprintf(stderr, " %s\n", *d ? "non-null" : "NULL"); break; }
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_HS:
+      case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_GS: {
+         const WRAP(D3D12_SHADER_BYTECODE) *w = (const void *)(base + off);
+         size = sizeof(*w);
+         char sha[65] = "-";
+         if (w->desc.pShaderBytecode && w->desc.BytecodeLength)
+            sha256_hex(w->desc.pShaderBytecode, w->desc.BytecodeLength, sha);
+         uint64_t sfi0 = 0;
+         const bool has_sfi0 = dxil_sfi0(&w->desc, &sfi0);
+         fprintf(stderr, " DXIL %zu B sha256 %s SFI0=%s0x%llx NativeLowPrecision=%d\n", (size_t)w->desc.BytecodeLength, sha, has_sfi0 ? "" : "absent/",
+                 (unsigned long long)sfi0, !!(sfi0 & 0x40000));
+         ++stages;
+         break;
+      }
+      CASE(STREAM_OUTPUT, D3D12_STREAM_OUTPUT_DESC) fprintf(stderr, " entries=%u\n", d->NumEntries); break; }
+      CASE(BLEND, D3D12_BLEND_DESC)
+         fprintf(stderr, " alpha_to_coverage=%d independent=%d rt0{enable=%d logic=%d src=%d dst=%d op=%d srcA=%d dstA=%d opA=%d logicop=%d mask=0x%x}\n",
+                 d->AlphaToCoverageEnable, d->IndependentBlendEnable, d->RenderTarget[0].BlendEnable, d->RenderTarget[0].LogicOpEnable,
+                 d->RenderTarget[0].SrcBlend, d->RenderTarget[0].DestBlend, d->RenderTarget[0].BlendOp, d->RenderTarget[0].SrcBlendAlpha,
+                 d->RenderTarget[0].DestBlendAlpha, d->RenderTarget[0].BlendOpAlpha, d->RenderTarget[0].LogicOp, d->RenderTarget[0].RenderTargetWriteMask);
+         break; }
+      CASE(SAMPLE_MASK, UINT) fprintf(stderr, " 0x%x\n", *d); break; }
+      CASE(RASTERIZER, D3D12_RASTERIZER_DESC)
+         fprintf(stderr, " fill=%d cull=%d ccw=%d bias=%d clamp=%f slope=%f clip=%d msaa=%d aaline=%d forced=%u conservative=%d\n", d->FillMode, d->CullMode,
+                 d->FrontCounterClockwise, d->DepthBias, d->DepthBiasClamp, d->SlopeScaledDepthBias, d->DepthClipEnable, d->MultisampleEnable,
+                 d->AntialiasedLineEnable, d->ForcedSampleCount, d->ConservativeRaster);
+         break; }
+      CASE(RASTERIZER1, D3D12_RASTERIZER_DESC1)
+         fprintf(stderr, " fill=%d cull=%d ccw=%d bias=%f clamp=%f slope=%f clip=%d\n", d->FillMode, d->CullMode, d->FrontCounterClockwise, d->DepthBias,
+                 d->DepthBiasClamp, d->SlopeScaledDepthBias, d->DepthClipEnable);
+         break; }
+      CASE(RASTERIZER2, D3D12_RASTERIZER_DESC2)
+         fprintf(stderr, " fill=%d cull=%d ccw=%d bias=%f clamp=%f slope=%f clip=%d line=%d forced=%u conservative=%d\n", d->FillMode, d->CullMode,
+                 d->FrontCounterClockwise, d->DepthBias, d->DepthBiasClamp, d->SlopeScaledDepthBias, d->DepthClipEnable, d->LineRasterizationMode,
+                 d->ForcedSampleCount, d->ConservativeRaster);
+         break; }
+      CASE(DEPTH_STENCIL, D3D12_DEPTH_STENCIL_DESC)
+         fprintf(stderr, " depth{enable=%d write=%d func=%d} stencil{enable=%d read=0x%02x write=0x%02x}\n", d->DepthEnable, d->DepthWriteMask, d->DepthFunc,
+                 d->StencilEnable, d->StencilReadMask, d->StencilWriteMask);
+         log_face("front", &d->FrontFace);
+         log_face("back", &d->BackFace);
+         break; }
+      CASE(DEPTH_STENCIL1, D3D12_DEPTH_STENCIL_DESC1)
+         fprintf(stderr, " depth{enable=%d write=%d func=%d} stencil{enable=%d read=0x%02x write=0x%02x} bounds=%d\n", d->DepthEnable, d->DepthWriteMask,
+                 d->DepthFunc, d->StencilEnable, d->StencilReadMask, d->StencilWriteMask, d->DepthBoundsTestEnable);
+         log_face("front", &d->FrontFace);
+         log_face("back", &d->BackFace);
+         break; }
+      CASE(DEPTH_STENCIL2, D3D12_DEPTH_STENCIL_DESC2)
+         fprintf(stderr, " depth{enable=%d write=%d func=%d} stencil{enable=%d} bounds=%d\n", d->DepthEnable, d->DepthWriteMask, d->DepthFunc,
+                 d->StencilEnable, d->DepthBoundsTestEnable);
+         log_face1("front", &d->FrontFace);
+         log_face1("back", &d->BackFace);
+         break; }
+      CASE(INPUT_LAYOUT, D3D12_INPUT_LAYOUT_DESC)
+         fprintf(stderr, " elements=%u\n", d->NumElements);
+         for (UINT i = 0; i < d->NumElements && d->pInputElementDescs; i++)
+            fprintf(stderr, "[vitox-pso]       element %u: %s%u format=%d slot=%u offset=%u class=%d step=%u\n", i, d->pInputElementDescs[i].SemanticName,
+                    d->pInputElementDescs[i].SemanticIndex, d->pInputElementDescs[i].Format, d->pInputElementDescs[i].InputSlot,
+                    d->pInputElementDescs[i].AlignedByteOffset, d->pInputElementDescs[i].InputSlotClass, d->pInputElementDescs[i].InstanceDataStepRate);
+         break; }
+      CASE(IB_STRIP_CUT_VALUE, D3D12_INDEX_BUFFER_STRIP_CUT_VALUE) fprintf(stderr, " %d\n", *d); break; }
+      CASE(PRIMITIVE_TOPOLOGY, D3D12_PRIMITIVE_TOPOLOGY_TYPE) fprintf(stderr, " type=%d\n", *d); break; }
+      CASE(RENDER_TARGET_FORMATS, vitox_rt_format_array)
+         fprintf(stderr, " count=%u formats=%d,%d,%d,%d\n", d->NumRenderTargets, d->RTFormats[0], d->RTFormats[1], d->RTFormats[2], d->RTFormats[3]);
+         break; }
+      CASE(DEPTH_STENCIL_FORMAT, DXGI_FORMAT) fprintf(stderr, " %d\n", *d); break; }
+      CASE(SAMPLE_DESC, DXGI_SAMPLE_DESC) fprintf(stderr, " count=%u quality=%u\n", d->Count, d->Quality); break; }
+      CASE(NODE_MASK, UINT) fprintf(stderr, " 0x%x\n", *d); break; }
+      CASE(CACHED_PSO, D3D12_CACHED_PIPELINE_STATE) fprintf(stderr, " %zu B\n", (size_t)d->CachedBlobSizeInBytes); break; }
+      CASE(FLAGS, D3D12_PIPELINE_STATE_FLAGS) fprintf(stderr, " 0x%x\n", *d); break; }
+      CASE(VIEW_INSTANCING, D3D12_VIEW_INSTANCING_DESC) fprintf(stderr, " count=%u flags=0x%x\n", d->ViewInstanceCount, d->Flags); break; }
+      default:
+         fprintf(stderr, " (unknown subobject: walk stopped)\n");
+         size = 0;
+         break;
+      }
+      if (!size)
+         break;
+      off += size;
+      ++subidx;
+   }
+   fprintf(stderr, "[vitox-pso]   subobjects=%u shader stages=%u (walked %zu of %zu bytes)\n", subidx, stages, off, (size_t)stream->SizeInBytes);
+   fflush(stderr);
+   capture_control(path, hr, stream);
+}
