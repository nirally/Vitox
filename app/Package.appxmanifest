<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap mp">

  <!-- Identity is fixed from the first physical-test package onward. Bump only Version. -->
  <Identity Name="Vitox.M1Probe" Publisher="CN=Vitox" Version="0.0.32.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="3b7c2e41-6f0a-4d8e-9c51-7a2d0e4b1f01" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Vitox</DisplayName>
    <PublisherDisplayName>Vitox</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="VitoxM1Probe.exe" EntryPoint="VitoxM1Probe.App">
      <uap:VisualElements
        DisplayName="Vitox"
        Description="Vitox - PlayStation Vita runtime"
        BackgroundColor="#0B0518"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0518" />
      </uap:VisualElements>
      <!-- 0.0.29.0: the launcher's USB installer lists .zip / .vpk archives on removable drives (removableStorage shows
           only the file types declared here) -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="vitoxarchive">
            <uap:DisplayName>Vita game archive</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.vpk</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- 0.0.29.0: install games / DLC from a USB drive (launcher Library "+" tile) -->
    <uap:Capability Name="removableStorage" />
    <!-- Required for VirtualProtectFromApp(PAGE_EXECUTE_READ) - raw JIT probe 4. -->
    <Capability Name="codeGeneration" />
    <!-- 0.0.26.0: the launcher's SteamGridDB artwork browser (www.steamgriddb.com API + its image CDN) -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
