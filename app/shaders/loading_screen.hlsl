float4 vs_main(uint id : SV_VertexID) : SV_Position {
    const float2 uv = float2((id << 1) & 2, id & 2);
    return float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
}

uint char_at(uint ln, uint i) {
    const uint idx = ln * 24 + i;
    const uint4 w4 = text[idx >> 4];
    const uint q = (idx >> 2) & 3;
    const uint w = q == 0 ? w4.x : (q == 1 ? w4.y : (q == 2 ? w4.z : w4.w));
    return (w >> ((idx & 3) * 8)) & 0xFF;
}

uint glyph_row(uint c, uint row) {
    if (c >= 97 && c <= 122)
        c -= 32;
    if (c < 32 || c > 95)
        return 0;
    const uint2 g = FONT[c - 32];
    return row < 4 ? (g.x >> (5 * (3 - row))) & 31 : (g.y >> (5 * (6 - row))) & 31;
}

// 1 where pixel p is covered by line `ln` (pixel font scaled by k, centred on cx, glyph top at top)
float text_line(float2 p, uint ln, float cx, float top, float k) {
    const uint n = lens[ln];
    if (n == 0)
        return 0;
    const float w = (n * 6.0 - 1.0) * k;
    const float2 o = floor(float2(cx - w * 0.5, top));
    const float2 l = (p - o) / k;
    if (l.x < 0 || l.y < 0 || l.y >= 7 || l.x >= n * 6.0)
        return 0;
    const uint col = (uint)l.x, row = (uint)l.y;
    const uint cx6 = col % 6;
    if (cx6 == 5)
        return 0;
    return (float)((glyph_row(char_at(ln, col / 6), row) >> (4 - cx6)) & 1);
}

float capsule(float2 p, float2 c, float hw, float hh) { // signed distance, negative inside
    const float2 q = abs(p - c) - float2(hw - hh, 0.0);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - hh;
}

float4 ps_main(float4 pos : SV_Position) : SV_Target {
    const float2 p = pos.xy;
    const float s = screen.y / 1080.0;
    const float2 uv = p / screen;
    const float v = length((uv - 0.5) * float2(screen.x / screen.y, 1.0));
    float3 col = lerp(float3(0.090, 0.105, 0.140), float3(0.030, 0.034, 0.046), saturate(v * 1.25));

    const float cx = screen.x * 0.5, cy = screen.y * 0.5;
    const float kt = max(1.0, round(7.0 * s)), kc = max(1.0, round(4.0 * s)), kf = max(1.0, round(3.0 * s));

    // title / caption above the bar, counter below, hint at the bottom
    col = lerp(col, float3(0.93, 0.94, 0.96), text_line(p, 0, cx, cy - 150.0 * s, kt));
    col = lerp(col, float3(0.58, 0.63, 0.71), text_line(p, 1, cx, cy - 62.0 * s, kc));
    col = lerp(col, float3(0.82, 0.85, 0.90), text_line(p, 2, cx, cy + 34.0 * s, kc));
    col = lerp(col, float3(0.36, 0.39, 0.45), text_line(p, 3, cx, screen.y - 96.0 * s, kf));

    // progress bar
    const float hw = min(460.0 * s, screen.x * 0.32), hh = 7.0 * s;
    const float2 bc = float2(cx, cy);
    const float d = capsule(p, bc, hw, hh);
    const float inside = saturate(0.5 - d);
    col = lerp(col, float3(0.17, 0.19, 0.24), inside);
    const float fill_end = bc.x - hw + 2.0 * hw * saturate(progress);
    const float fill = inside * saturate(fill_end - p.x + 0.5) * step(0.001, progress);
    const float t = saturate((p.x - (bc.x - hw)) / (2.0 * hw));
    float3 fc = lerp(float3(0.33, 0.56, 1.00), float3(0.64, 0.43, 1.00), t);
    const float sheen_x = bc.x - hw + frac(time * 0.45) * (2.0 * hw + 240.0 * s) - 120.0 * s;
    fc += 0.30 * exp(-pow((p.x - sheen_x) / (60.0 * s), 2.0));
    col = lerp(col, fc, fill);
    // soft glow under the filled part
    const float past = max(p.x - fill_end, 0.0); // fade the glow out smoothly past the end of the fill (0.0.24.199)
    const float glow = exp(-max(d, 0.0) / (10.0 * s)) * (1.0 - inside) * exp(-past * past / (200.0 * s * s)) * step(0.001, progress);
    col += float3(0.20, 0.22, 0.45) * glow * 0.35;

    const float fade = saturate(time / 0.35);
    return float4(col * fade, 1.0);
}
