    { 0xB9D5EBDE, 0x37FE725A }, { 0xB8EF5818, 0x37FE725A },                                                         // SceSysmem
    { 0x9670D39F, 0xCAE9ACE6 }, { 0x6C60AC61, 0xCAE9ACE6 }, { 0x7595D9AA, 0xCAE9ACE6 },                             // SceLibKernel
    { 0xC70B8886, 0xF2FF276E }, { 0x34EFD876, 0xF2FF276E },                                                         // SceIofilemgr
